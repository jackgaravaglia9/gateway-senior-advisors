# GA4 Measurement ID (Admin > Data Streams > your web stream). Exposed to the client.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Apps Script Web App URL that appends submissions to the Google Sheet.
# Server-side only — never exposed to the client.
SHEET_WEBHOOK_URL=

# PostHog project API key (Project Settings > Project API Key). Exposed to the client.
NEXT_PUBLIC_POSTHOG_KEY=

# PostHog ingestion host. Use https://us.i.posthog.com (US cloud, default if
# left blank) or https://eu.i.posthog.com (EU cloud) — match your project's region.
NEXT_PUBLIC_POSTHOG_HOST=
